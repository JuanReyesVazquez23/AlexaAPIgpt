# Copia este archivo a .env solo para pruebas LOCALES.
# En Vercel, estas variables se configuran en Settings -> Environment Variables,
# el archivo .env no se usa en producción.

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional pero recomendado: restringe el endpoint para que solo acepte
# solicitudes de tu propio Alexa Skill (ver sección "Seguridad" en el README).
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxxxxxxxxxx

# Puerto local (Vercel lo asigna automáticamente en producción)
PORT=5000
